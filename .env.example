# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL
#
# Local:  docker compose up -d      (o Postgres nativo)
#   DATABASE_URL="postgresql://aisolves:aisolves@localhost:5432/aisolves?schema=public"
#
# Producción (Neon / Supabase / RDS): usa la cadena POOLED en DATABASE_URL y la
# DIRECTA en DIRECT_URL. Las migraciones no pueden correr sobre un pooler.
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://aisolves:aisolves@localhost:5432/aisolves?schema=public"
DIRECT_URL="postgresql://aisolves:aisolves@localhost:5432/aisolves?schema=public"

# ---------------------------------------------------------------------------
# SITE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="34600000000"          # digits only, with country code

# ---------------------------------------------------------------------------
# AUTH  (npx auth secret  ->  generates AUTH_SECRET)
# Google:   console.cloud.google.com -> OAuth client (Web)
#           Redirect URI: {SITE_URL}/api/auth/callback/google
# Facebook: developers.facebook.com -> Facebook Login
#           Redirect URI: {SITE_URL}/api/auth/callback/facebook
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Comma-separated emails that get the admin dashboard.
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# META  (Events Manager -> Data sources -> your pixel -> Settings)
# META_CAPI_TOKEN: "Generate access token" in the Conversions API section.
# META_TEST_EVENT_CODE: set while testing, REMOVE in production or events are
#   only visible in the Test Events tab and never reach the optimiser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""

# ---------------------------------------------------------------------------
# GOOGLE  (GA4 Admin -> Data Streams -> Measurement Protocol API secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# ---------------------------------------------------------------------------
# TIKTOK / LINKEDIN  (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
TIKTOK_PIXEL_ID=""
TIKTOK_ACCESS_TOKEN=""
NEXT_PUBLIC_LINKEDIN_ID=""
